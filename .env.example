MONGODB_URI=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=google
WIDGET_DAILY_MSG_CAP=50   # default 50 (was 200). Combined per-org/day counter across both providers. Each visitor message records TWO units (Gemini embedding + chat completion), and GOOGLE_GENERATIVE_AI_API_KEY/GROQ_API_KEY are single GLOBAL free-tier keys (~250-1000 req/day for the whole key) shared by every tenant.
WIDGET_RATE_LIMIT_PER_MIN=20   # default 20. Coarse per-caller throttle on /api/chat and /api/chat/escalate (Mongo counter, no new service).
WIDGET_TOKEN_SECRET=   # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESEND_API_KEY=
AUTH_SECRET=
TRIGGER_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=   # Vercel Blob store (Storage tab of the Vercel project)
APP_URL=http://localhost:3000   # MUST match the deployed origin: /api/chat and /api/chat/escalate reject any request whose Origin header is present and differs from this.
